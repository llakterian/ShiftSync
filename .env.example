# Environment Variables
# Copy this file to .env.local and fill in your values

# -----------------------------------------------
# DATABASE (Required)
# From Supabase: Settings > Database > Connection string (Transaction mode)
# -----------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:6543/postgres

# -----------------------------------------------
# OPENAI (Required for Smart Assist)
# Get from: https://platform.openai.com/api-keys
# -----------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------
# NEXTAUTH (Required for session management when auth is added)
# Generate with: openssl rand -base64 32
# -----------------------------------------------
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
